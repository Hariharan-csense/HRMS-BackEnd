<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Payslip - {{display_month}}</title>
  <style>
    @page {
      size: A4;
      margin: 10mm;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background: #eef2f7;
      color: #1f2937;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      line-height: 1.45;
    }

    .payslip {
      width: 100%;
      max-width: 790px;
      margin: 0 auto;
      background: #ffffff;
      border: 1px solid #d9e2ec;
      border-radius: 6px;
      overflow: hidden;
    }

    .topbar {
      height: 8px;
      background: #0f766e;
    }

    .header {
      display: table;
      width: 100%;
      padding: 22px 28px 18px;
      border-bottom: 1px solid #e5e7eb;
    }

    .brand,
    .doc-meta {
      display: table-cell;
      vertical-align: middle;
    }

    .brand-logo {
      display: inline-block;
      width: 66px;
      height: 66px;
      margin-right: 14px;
      vertical-align: middle;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      object-fit: contain;
      padding: 6px;
      background: #ffffff;
    }

    .brand-initial {
      display: inline-block;
      min-width: 66px;
      height: 66px;
      margin-right: 14px;
      vertical-align: middle;
      border-radius: 6px;
      background: #0f766e;
      color: #ffffff;
      font-size: 22px;
      font-weight: 700;
      line-height: 66px;
      text-align: center;
    }

    .brand-text {
      display: inline-block;
      max-width: 430px;
      vertical-align: middle;
    }

    .company-name {
      margin: 0 0 4px;
      color: #111827;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0;
    }

    .company-address {
      margin: 0;
      color: #64748b;
      font-size: 10px;
    }

    .doc-meta {
      width: 190px;
      text-align: right;
    }

    .doc-title {
      margin: 0 0 8px;
      color: #0f766e;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .meta-pill {
      display: inline-block;
      border: 1px solid #b7e4dc;
      border-radius: 999px;
      padding: 5px 12px;
      background: #ecfdf5;
      color: #0f766e;
      font-size: 11px;
      font-weight: 700;
    }

    .content {
      padding: 22px 28px 24px;
    }

    .summary-row {
      display: table;
      width: 100%;
      margin-bottom: 16px;
    }

    .summary-card {
      display: table-cell;
      width: 50%;
      padding: 0 6px;
      vertical-align: top;
    }

    .summary-card:first-child {
      padding-left: 0;
    }

    .summary-card:last-child {
      padding-right: 0;
    }

    .panel {
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      overflow: hidden;
      background: #ffffff;
    }

    .panel-title {
      padding: 9px 12px;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
      color: #0f766e;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .info-grid {
      display: table;
      width: 100%;
      padding: 8px 12px;
    }

    .info-row {
      display: table-row;
    }

    .label,
    .value {
      display: table-cell;
      padding: 5px 0;
      border-bottom: 1px solid #f1f5f9;
    }

    .info-row:last-child .label,
    .info-row:last-child .value {
      border-bottom: 0;
    }

    .label {
      width: 45%;
      color: #64748b;
      font-size: 10px;
      text-transform: uppercase;
    }

    .value {
      color: #111827;
      font-weight: 700;
      text-align: right;
    }

    .salary-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      border: 1px solid #d9e2ec;
      border-radius: 6px;
      overflow: hidden;
    }

    .salary-table th {
      padding: 10px 12px;
      background: #0f766e;
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      text-align: left;
      text-transform: uppercase;
    }

    .salary-table td {
      padding: 9px 12px;
      border-bottom: 1px solid #edf2f7;
      color: #334155;
      font-size: 11px;
    }

    .salary-table tr:nth-child(even) td {
      background: #fbfdff;
    }

    .salary-table .amount {
      color: #111827;
      font-weight: 700;
      text-align: right;
      white-space: nowrap;
    }

    .salary-table .deduction {
      color: #b91c1c;
    }

    .salary-table .total-row td {
      background: #f0fdfa;
      border-top: 2px solid #0f766e;
      border-bottom: 0;
      color: #0f766e;
      font-weight: 700;
    }

    .net-row {
      display: table;
      width: 100%;
      margin: 16px 0;
      border: 1px solid #b7e4dc;
      border-radius: 6px;
      background: #ecfdf5;
    }

    .net-copy,
    .net-amount {
      display: table-cell;
      padding: 14px 16px;
      vertical-align: middle;
    }

    .net-copy {
      color: #0f766e;
      font-weight: 700;
      text-transform: uppercase;
    }

    .net-copy small {
      display: block;
      margin-top: 2px;
      color: #64748b;
      font-size: 10px;
      font-weight: 400;
      text-transform: none;
    }

    .net-amount {
      color: #065f46;
      font-size: 22px;
      font-weight: 700;
      text-align: right;
      white-space: nowrap;
    }

    .amount-words {
      margin: -8px 0 16px;
      padding: 10px 14px;
      border: 1px solid #d9e2ec;
      border-radius: 6px;
      background: #fbfdff;
      color: #334155;
      font-size: 10px;
    }

    .amount-words strong {
      color: #0f766e;
      text-transform: uppercase;
    }

    .annual {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      overflow: hidden;
    }

    .annual th,
    .annual td {
      padding: 9px 12px;
      border-bottom: 1px solid #edf2f7;
      text-align: left;
    }

    .annual th {
      width: 55%;
      color: #64748b;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .annual td {
      color: #111827;
      font-weight: 700;
      text-align: right;
    }

    .sign-row {
      display: table;
      width: 100%;
      margin-top: 22px;
      padding-top: 14px;
      border-top: 1px solid #e5e7eb;
    }

    .note,
    .signature-box {
      display: table-cell;
      vertical-align: bottom;
    }

    .note {
      width: 60%;
      color: #64748b;
      font-size: 10px;
    }

    .signature-box {
      width: 40%;
      text-align: right;
    }

    .signature-img {
      display: inline-block;
      max-width: 180px;
      max-height: 72px;
      object-fit: contain;
      margin-bottom: 8px;
    }

    .signature-line {
      display: inline-block;
      width: 190px;
      border-top: 1px solid #94a3b8;
      padding-top: 6px;
      color: #111827;
      font-size: 10px;
      font-weight: 700;
      text-align: center;
      text-transform: uppercase;
    }

    .footer {
      padding: 11px 28px;
      border-top: 1px solid #e5e7eb;
      background: #f8fafc;
      color: #64748b;
      font-size: 9px;
      text-align: center;
    }

    table,
    tr,
    td,
    th,
    .panel,
    .net-row,
    .sign-row {
      page-break-inside: avoid;
    }

    @media print {
      body {
        background: #ffffff;
      }

      .payslip {
        border-radius: 0;
      }
    }
  </style>
</head>

<body>
  <div class="payslip">
    <div class="topbar"></div>

    <div class="header">
      <div class="brand">
        {{#if company_logo}}
        <img class="brand-logo" src="{{company_logo}}" alt="Company Logo">
        {{else}}
        <span class="brand-initial">CO</span>
        {{/if}}
        <div class="brand-text">
          <h1 class="company-name">{{company_name}}</h1>
          <p class="company-address">{{company_address}}</p>
        </div>
      </div>
      <div class="doc-meta">
        <h2 class="doc-title">Payslip</h2>
        <span class="meta-pill">{{display_month}}</span>
      </div>
    </div>

    <div class="content">
      <div class="summary-row">
        <div class="summary-card">
          <div class="panel">
            <div class="panel-title">Employee Details</div>
            <div class="info-grid">
              <div class="info-row">
                <div class="label">Employee Code</div>
                <div class="value">{{employee_code}}</div>
              </div>
              <div class="info-row">
                <div class="label">Employee</div>
                <div class="value">{{employee_name}}</div>
              </div>
              <div class="info-row">
                <div class="label">Department</div>
                <div class="value">{{department_name}}</div>
              </div>
              <div class="info-row">
                <div class="label">Designation</div>
                <div class="value">{{designation_name}}</div>
              </div>
              <div class="info-row">
                <div class="label">Branch</div>
                <div class="value">{{branch_name}}</div>
              </div>
              <div class="info-row">
                <div class="label">UAN</div>
                <div class="value">{{uan_number}}</div>
              </div>
              <div class="info-row">
                <div class="label">ESI</div>
                <div class="value">{{esi_number}}</div>
              </div>
            </div>
          </div>
        </div>

        <div class="summary-card">
          <div class="panel">
            <div class="panel-title">Pay & Bank Details</div>
            <div class="info-grid">
              <div class="info-row">
                <div class="label">Salary Period</div>
                <div class="value">{{payroll_period}}</div>
              </div>
              <div class="info-row">
                <div class="label">Total Days</div>
                <div class="value">{{total_days}}</div>
              </div>
              <div class="info-row">
                <div class="label">Present Days</div>
                <div class="value">{{present_days}}</div>
              </div>
              <div class="info-row">
                <div class="label">Paid Leave</div>
                <div class="value">{{approved_leave_days}}</div>
              </div>
              <div class="info-row">
                <div class="label">LOP Days</div>
                <div class="value">{{lop_days}}</div>
              </div>
              <div class="info-row">
                <div class="label">Payable Days</div>
                <div class="value">{{payable_days}}</div>
              </div>
              <div class="info-row">
                <div class="label">Bank</div>
                <div class="value">{{bank_name}}</div>
              </div>
              <div class="info-row">
                <div class="label">Account</div>
                <div class="value">{{account_no}}</div>
              </div>
              <div class="info-row">
                <div class="label">IFSC</div>
                <div class="value">{{ifsc_code}}</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-title">Salary Statement</div>
        <table class="salary-table">
          <tr>
            <th>Earnings</th>
            <th>Amount (INR)</th>
            <th>Deductions</th>
            <th>Amount (INR)</th>
          </tr>
          <tr>
            <td>Basic Salary</td>
            <td class="amount">&#8377;{{basic}}</td>
            <td>Provident Fund</td>
            <td class="amount deduction">&#8377;{{pf}}</td>
          </tr>
          <tr>
            <td>House Rent Allowance</td>
            <td class="amount">&#8377;{{hra}}</td>
            <td>ESI</td>
            <td class="amount deduction">&#8377;{{esi}}</td>
          </tr>
          <tr>
            <td>Allowances</td>
            <td class="amount">&#8377;{{allowances}}</td>
            <td>Professional Tax</td>
            <td class="amount deduction">&#8377;{{pt}}</td>
          </tr>
          <tr>
            <td>Incentives</td>
            <td class="amount">&#8377;{{incentives}}</td>
            <td>TDS {{#if tds_percentage}}({{tds_percentage}}%){{/if}}</td>
            <td class="amount deduction">&#8377;{{tds}}</td>
          </tr>
          <tr>
            <td>Leave Travel Allowance</td>
            <td class="amount">&#8377;{{lta}}</td>
            <td>Other Deductions</td>
            <td class="amount deduction">&#8377;{{other_deductions}}</td>
          </tr>
          <tr>
            <td>Expense Reimbursements</td>
            <td class="amount">&#8377;{{total_expenses}}</td>
            <td></td>
            <td class="amount"></td>
          </tr>
          <tr class="total-row">
            <td>Gross Earnings</td>
            <td class="amount">&#8377;{{gross}}</td>
            <td>Total Deductions</td>
            <td class="amount">&#8377;{{monthly_deductions}}</td>
          </tr>
        </table>
      </div>

      <div class="net-row">
        <div class="net-copy">
          Net Pay for {{display_month}}
          <small>Amount payable after statutory deductions and adjustments</small>
        </div>
        <div class="net-amount">&#8377;{{monthly_net}}</div>
      </div>

      {{!-- <div class="amount-words">
        <strong>Amount in Words:</strong> {{monthly_net_words}}
      </div> --}}

      {{!-- <div class="panel">
        <div class="panel-title">Annual Projection</div>
        <table class="annual">
          <tr>
            <th>Annual Gross Salary</th>
            <td>&#8377;{{annual_gross}}</td>
          </tr>
          <tr>
            <th>Annual Deductions</th>
            <td>&#8377;{{annual_deductions}}</td>
          </tr>
          <tr>
            <th>Annual Net Salary</th>
            <td>&#8377;{{annual_net}}</td>
          </tr>
        </table>
      </div> --}}

      <div class="sign-row">
        <div class="note">
          This payslip is generated by the payroll system for official salary records.<br>
          Generated on {{current_date}}
        </div>
        <div class="signature-box">
          {{#if company_signature}}
          <img class="signature-img" src="{{company_signature}}" alt="Authorized Signature">
          {{/if}}
          <div class="signature-line">Authorized Signatory</div>
        </div>
      </div>
    </div>

    <div class="footer">
      &copy; {{company_name}} | Confidential payroll document
    </div>
  </div>
</body>

</html>
