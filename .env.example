# Optional eSSL framework. Device communication requires a confirmed adapter.
ESSL_ENABLED=false
ESSL_SYNC_ENABLED=false
ESSL_SYNC_INTERVAL_MINUTES=5
ESSL_CONNECTION_TIMEOUT=10000

# Facial recognition (set FACE_SERVICE_TOKEN privately in backend/.env)
PYTHON_FACE_SERVICE_URL=http://127.0.0.1:8001
PYTHON_FACE_SERVICE_TIMEOUT_MS=10000
FACE_RECOGNITION_ENGINE=python
FACE_MODEL_NAME=buffalo_s
FACE_MODEL_VERSION=insightface-buffalo_s
# Starting values only; calibrate with labeled camera images before production.
FACE_MATCH_THRESHOLD=0.65
FACE_AMBIGUITY_MARGIN=0.10
FACE_EMBEDDING_DIMENSION=512
FACE_RECOGNITION_DEBUG=false
